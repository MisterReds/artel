#!/usr/bin/env python3
"""Stand-in for the `dsh` CLI in tests: only plugin management (`dsh plugin --profile P add <specs>`), logged to
$FAKE_DSH_LOG. Records the installed packages in the profile manifest like the real command does."""
import json, os, sys
from pathlib import Path

args = sys.argv[1:]
home = os.environ.get("DSH_HOME")
if not home:
    print("dsh: the Python runtime command requires an explicit DSH_HOME", file=sys.stderr); sys.exit(2)
with open(os.environ["FAKE_DSH_LOG"], "a") as f:
    f.write(json.dumps({"cli": args, "home": home}) + "\n")
if args[:1] == ["--version"]:
    print("0.0.0-fake"); sys.exit(0)
if args[:1] == ["plugin"] and args[1] == "--profile" and args[3] == "add":
    if os.environ.get("FAKE_DSH_PNPM_MISSING"):
        print("dsh plugin: pnpm not found on PATH", file=sys.stderr); sys.exit(1)
    prof = Path(home) / "profiles" / args[2]
    prof.mkdir(parents=True, exist_ok=True)
    pkg = prof / "package.json"
    data = json.loads(pkg.read_text()) if pkg.exists() else {"dependencies": {}}
    for spec in args[4:]:
        data["dependencies"][spec] = "*"
    pkg.write_text(json.dumps(data))
    sys.exit(0)
print("unsupported", args, file=sys.stderr); sys.exit(2)
