#!/usr/bin/env python3
"""Stand-in for the OpenAI Codex CLI in tests: device login, login status, and `exec --json` that does some work
and finishes by calling Artel's terminal tool through the MCP bridge configured with -c mcp_servers.artel.args."""
import json, os, sys, time, urllib.request
from pathlib import Path

home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
args = sys.argv[1:]
if args[:1] == ["--version"]:
    print("codex-cli 9.9.9-fake"); sys.exit(0)
if args[:2] == ["login", "status"]:
    print("Logged in using ChatGPT" if (home / "auth.json").exists() else "Not logged in")
    sys.exit(0 if (home / "auth.json").exists() else 1)
if args[:2] == ["debug", "models"]:
    lv = [{"effort": e} for e in ("low", "medium", "high")]
    print(json.dumps({"models": [
        {"slug": "gpt-fake-luna", "display_name": "GPT-Fake-Luna", "visibility": "list", "default_reasoning_level": "medium",
         "supported_reasoning_levels": lv},
        {"slug": "gpt-fake-sol", "display_name": "GPT-Fake-Sol", "visibility": "list", "supported_reasoning_levels": lv},
        {"slug": "internal-x", "display_name": "x", "visibility": "hide"}]})); sys.exit(0)
if args[:1] == ["logout"]:
    (home / "auth.json").unlink(missing_ok=True); print("Successfully logged out"); sys.exit(0)
if args[:2] == ["login", "--device-auth"]:
    print("\x1b[94mWelcome to Codex\x1b[0m\n\n1. Open this link in your browser and sign in to your account\n"
          "   \x1b[94mhttps://auth.openai.com/codex/device\x1b[0m\n\n2. Enter this one-time code \x1b[90m(expires in 15 minutes)\x1b[0m\n"
          "   \x1b[94mABCD-EFG12\x1b[0m\n", flush=True)
    for _ in range(200):  # the test "confirms in the browser" by creating this file
        if (home / "confirm").exists():
            home.mkdir(parents=True, exist_ok=True); (home / "auth.json").write_text("{}"); print("Successfully logged in"); sys.exit(0)
        time.sleep(0.05)
    sys.exit(1)
BWRAP = "bwrap: loopback: Failed RTM_NEWADDR: Operation not permitted"
if args[:1] == ["sandbox"]:  # FAKE_CODEX_SANDBOX: nonet = works only with network on, broken = never works
    mode = os.environ.get("FAKE_CODEX_SANDBOX", "")
    net = "sandbox_workspace_write.network_access=true" in args
    if mode == "broken" or (mode == "nonet" and not net):
        print(BWRAP, file=sys.stderr); sys.exit(1)
    cmd = args[args.index("--") + 1:]
    os.execvp(cmd[0], cmd)
assert args[0] == "exec", args
cfg = {}
for i, a in enumerate(args):
    if a == "-c":
        k, v = args[i + 1].split("=", 1); cfg[k] = v
url, token = json.loads(cfg["mcp_servers.artel.args"])[2:4]
log = Path(os.environ["FAKE_CODEX_LOG"]); log.write_text(log.read_text() + json.dumps(args) + "\n" if log.exists() else json.dumps(args) + "\n")
prompt = sys.stdin.read()
emit = lambda o: print(json.dumps(o), flush=True)
resumed = "resume" in args
emit({"type": "thread.started", "thread_id": "th-1"})
emit({"type": "turn.started"})
if os.environ.get("FAKE_CODEX_LIMIT"):
    emit({"type": "turn.failed", "error": {"message": "You've hit your usage limit. Try again at 4:20 PM."}}); sys.exit(1)
if os.environ.get("FAKE_CODEX_CMD"):  # a command about to run: Artel's policy must stop the process
    emit({"type": "item.started", "item": {"id": "c1", "type": "command_execution", "command": os.environ["FAKE_CODEX_CMD"], "status": "in_progress"}})
    time.sleep(5); sys.exit(0)
if os.environ.get("FAKE_CODEX_SANDBOX") == "exec-broken" and "--dangerously-bypass-approvals-and-sandbox" not in args:
    emit({"type": "item.completed", "item": {"id": "s1", "type": "command_execution", "command": "ls -la", "aggregated_output": BWRAP, "exit_code": 1, "status": "failed"}})
    time.sleep(5); sys.exit(0)
emit({"type": "item.completed", "item": {"id": "i1", "type": "agent_message", "text": "Writing the file." if not resumed else "Finishing."}})
emit({"type": "item.completed", "item": {"id": "i2", "type": "file_change", "status": "completed", "changes": [{"path": "hello.py", "kind": "add"}]}})
Path("hello.py").write_text("print('hi')\n")
if os.environ.get("FAKE_CODEX_WRITE"):  # a misbehaving agent writing outside its own directory
    Path(os.environ["FAKE_CODEX_WRITE"]).write_text("changed by the agent\n")
emit({"type": "item.completed", "item": {"id": "i3", "type": "command_execution", "command": "python hello.py", "aggregated_output": "hi\n", "exit_code": 0, "status": "completed"}})
if os.environ.get("FAKE_CODEX_LAZY") and not resumed:  # first run ends without a terminal tool -> Artel resumes
    emit({"type": "turn.completed", "usage": {"input_tokens": 100, "cached_input_tokens": 10, "output_tokens": 20}}); sys.exit(0)
def call(name, a):
    req = urllib.request.Request(url, data=json.dumps({"name": name, "args": a}).encode(),
                                 headers={"X-Artel-Token": token, "Content-Type": "application/json"})
    return json.loads(urllib.request.urlopen(req).read())
r = call("task_submit", {"summary": "hello.py prints hi", "evidence": "$ python hello.py\nhi"})
emit({"type": "item.completed", "item": {"id": "i4", "type": "mcp_tool_call", "server": "artel", "tool": "task_submit", "arguments": {}, "status": "completed"}})
emit({"type": "turn.completed", "usage": {"input_tokens": 1000, "cached_input_tokens": 400, "output_tokens": 200}})
time.sleep(30)  # Artel stops the run right after the turn is closed
