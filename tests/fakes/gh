#!/usr/bin/env python3
"""Stand-in for the GitHub CLI: auth status, label/issue list/create/comment; state in FAKE_GH_STATE (json)."""
import json, os, sys
from pathlib import Path

state_p = Path(os.environ["FAKE_GH_STATE"])
state = json.loads(state_p.read_text()) if state_p.exists() else {"issues": [], "comments": [], "calls": []}
a = sys.argv[1:]
state["calls"].append(a)
body = sys.stdin.read() if "--body-file" in a else ""
out = ""
if a[:2] == ["auth", "status"]:
    out = "Logged in"
elif a[:2] == ["label", "create"]:
    pass
elif a[:2] == ["issue", "list"]:
    q = a[a.index("--search") + 1].split()[0]
    out = json.dumps([{"number": i["number"], "url": i["url"]} for i in state["issues"] if q in i["body"]][:1])
elif a[:2] == ["issue", "create"]:
    n = len(state["issues"]) + 1
    url = f"https://github.com/o/r/issues/{n}"
    state["issues"].append({"number": n, "url": url, "title": a[a.index("--title") + 1], "body": body})
    out = url
elif a[:2] == ["issue", "comment"]:
    state["comments"].append({"number": int(a[2]), "body": body})
state_p.write_text(json.dumps(state))
print(out)
