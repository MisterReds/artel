#!/usr/bin/env python3
"""Stand-in for an external MCP server in tests: stdio JSON lines, tools echo(text) and env(name)."""
import json, os, sys

TOOLS = [{"name": "echo", "description": "Echo text back",
          "inputSchema": {"type": "object", "properties": {"text": {"type": "string"}}, "required": ["text"]}},
         {"name": "env", "description": "Read an environment variable",
          "inputSchema": {"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}}]

for line in sys.stdin:
    msg = json.loads(line)
    mid, method = msg.get("id"), msg.get("method")
    if mid is None:
        continue
    if method == "initialize":
        res = {"protocolVersion": "2025-06-18", "capabilities": {"tools": {}}, "serverInfo": {"name": "fake", "version": "1"}}
    elif method == "tools/list":
        res = {"tools": TOOLS}
    elif method == "tools/call":
        p = msg["params"]; a = p.get("arguments") or {}
        text = f"echo: {a.get('text')}" if p["name"] == "echo" else os.environ.get(a.get("name", ""), "")
        res = {"content": [{"type": "text", "text": text}], "isError": False}
    else:
        res = {}
    print(json.dumps({"jsonrpc": "2.0", "id": mid, "result": res}), flush=True)
